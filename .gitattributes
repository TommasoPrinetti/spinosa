# Files to exclude from GitHub release tarballs
# git archive respects export-ignore

.gitattributes            export-ignore
.gitignore                export-ignore
.editorconfig             export-ignore
/tsconfig.json            export-ignore

# CI and community health
.github/                  export-ignore
CODE_OF_CONDUCT.md        export-ignore
CONTRIBUTING.md           export-ignore
SECURITY.md               export-ignore
SUPPORT.md                export-ignore
RELEASE_GUIDE.md          export-ignore
DEVELOPMENT.md            export-ignore

# Dev tools
tests/                    export-ignore
/script/                  export-ignore

# Package-level test directories (700+ files)
test/                     export-ignore

# Root-level project dev artifacts (not user-facing)
/.agents/                 export-ignore
/.assets/                 export-ignore

# Dev-only kernel migration scratch (must never ship)
packages/spinosa-kernel/.spinosa-migration-report.json  export-ignore

# Dev docs (internal work packages / handoffs / audits — not user-facing)
/docs/                    export-ignore
