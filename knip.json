{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "packages/spinosa-cli/src/index.ts",
    "packages/spinosa-kernel/src/index.ts",
    "packages/tui/src/spinosa-cli.ts",
    "script/build-tui.ts",
    "script/compare-versions.ts",
    "script/patch-local-install-metadata.ts",
    "script/publish-tui.ts",
    "script/set-version.ts",
    "script/typecheck-all.ts",
    "script/release/index.ts",
    "script/release/stages.ts",
    "script/release/state.ts",
    "script/release/bump.ts",
    "script/release/github.ts",
    "script/release/lib.ts",
    "script/release/reporter.ts",
    "script/generate-patches-md.ts",
    "workspace-template/.bin/spinosa"
  ],
  "project": [
    "packages/**/*.{ts,tsx}",
    "script/**/*.ts"
  ],
  "ignore": [
    "packages/**/test/**",
    "packages/**/dist/**",
    "packages/**/examples/**",
    "packages/**/example/**",
    "packages/**/script/**",
    "packages/spinosa-web-svelte/**",
    "packages/tui/tools/**",
    "packages/tui/scripts/**",
    "packages/plugin/src/example-workspace.ts",
    "packages/plugin/src/example.ts",
    "packages/plugin/src/v2/effect/**",
    "packages/sdk/src/gen/**",
    "packages/spinosa-cli/src/compiled.ts",
    "packages/spinosa-kernel/parsers-config.ts",
    "packages/spinosa-kernel/specs/**",
    "packages/tui/src/component/dialog-placeholder.tsx",
    "packages/tui/src/component/dialog-tag.tsx",
    "packages/tui/src/component/prompt/cwd.ts",
    "packages/tui/src/context/directory.ts",
    "packages/tui/src/feature-plugins/home/tips-view.tsx",
    "packages/tui/src/feature-plugins/home/tips.tsx",
    "packages/tui/src/routes/session/dialog-subagent.tsx",
    "packages/tui/src/routes/session/sidebar.tsx",
    "packages/tui/src/routes/spinosa/visualizer-sessions.tsx",
    "packages/tui/src/routes/spinosa/visualizer-types-view.tsx",
    "packages/tui/src/spinosa/workspace-bind.tsx",
    "script/**/*.test.ts"
  ],
  "ignoreDependencies": [
    "@cloudflare/workers-types",
    "@effect/platform-node-shared",
    "@ff-labs/fff-bun",
    "@gitlab/opencode-gitlab-auth",
    "@hono/zod-validator",
    "@img/sharp-darwin-arm64",
    "@napi-rs/canvas",
    "@openauthjs/openauth",
    "@opentelemetry/context-async-hooks",
    "@opentelemetry/exporter-trace-otlp-http",
    "@parcel/watcher",
    "@pierre/diffs",
    "@playwright/test",
    "@sentry/solid",
    "@sentry/vite-plugin",
    "@shikijs/stream",
    "@shikijs/transformers",
    "@solid-primitives/bounds",
    "@solid-primitives/event-bus",
    "@solid-primitives/media",
    "@solid-primitives/scheduled",
    "@solid-primitives/storage",
    "@solidjs/router",
    "@solidjs/start",
    "@spinosa/effect-sqlite-node",
    "@spinosa/ui",
    "@standard-schema/spec",
    "@tanstack/solid-virtual",
    "@zip.js/zip.js",
    "bats",
    "chokidar",
    "diff",
    "dompurify",
    "fast-check",
    "glob",
    "hono",
    "hono-openapi",
    "ignore",
    "immer",
    "luxon",
    "markitdown-ts",
    "minimatch",
    "morphdom",
    "motion-dom",
    "motion-utils",
    "msw",
    "partial-json",
    "pdfjs-dist",
    "ppu-paddle-ocr",
    "remend",
    "semver",
    "sst",
    "strip-ansi",
    "tree-sitter-bash",
    "tree-sitter-powershell",
    "xdg-basedir",
    "zx"
  ],
  "ignoreIssues": {
    "packages/spinosa-kernel/package.json": ["exports"]
  },
  "rules": {
    "binaries": "off",
    "catalog": "off",
    "dependencies": "off",
    "devDependencies": "off",
    "duplicates": "off",
    "exports": "off",
    "files": "error",
    "types": "off",
    "unlisted": "off"
  }
}
