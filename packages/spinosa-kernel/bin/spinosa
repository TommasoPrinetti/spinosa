#!/usr/bin/env bun

import fs from "node:fs"
import path from "node:path"
import { packageNameForPlatform } from "./platform.ts"

function commandOutput(command, args) {
  const result = Bun.spawnSync([command, ...args], {
    stdout: "pipe",
    stderr: "pipe",
  })
  const decoder = new TextDecoder()
  return `${decoder.decode(result.stdout)}${decoder.decode(result.stderr)}`
}

function supportsAvx2() {
  if (process.arch !== "x64") return true
  if (process.platform === "linux") {
    try {
      return /(^|\s)avx2(\s|$)/i.test(fs.readFileSync("/proc/cpuinfo", "utf8"))
    } catch {
      return false
    }
  }
  if (process.platform === "darwin") {
    return commandOutput("sysctl", ["-n", "hw.optional.avx2_0"]).trim() === "1"
  }
  return false
}

function usesMusl() {
  if (process.platform !== "linux") return false
  if (fs.existsSync("/etc/alpine-release")) return true
  try {
    return commandOutput("ldd", ["--version"]).toLowerCase().includes("musl")
  } catch {
    return false
  }
}

function findBinary(packageName) {
  let current = import.meta.dir
  for (;;) {
    const candidate = path.join(current, "node_modules", ...packageName.split("/"), "bin", "spinosa")
    if (fs.existsSync(candidate)) return candidate
    const parent = path.dirname(current)
    if (parent === current) return
    current = parent
  }
}

let packageName
try {
  packageName = packageNameForPlatform({
    platform: process.platform,
    arch: process.arch,
    musl: usesMusl(),
    avx2: supportsAvx2(),
  })
} catch (error) {
  console.error(error instanceof Error ? error.message : String(error))
  process.exit(1)
}
const target = findBinary(packageName)

if (!target) {
  console.error(
    `Spinosa platform package ${packageName} is missing. Reinstall the exact @spinosa/kernel version with Bun; the launcher does not download packages at runtime.`,
  )
  process.exit(1)
}

const child = Bun.spawn([target, ...process.argv.slice(2)], {
  stdin: "inherit",
  stdout: "inherit",
  stderr: "inherit",
})
for (const signal of ["SIGINT", "SIGTERM", "SIGHUP"]) {
  process.on(signal, () => child.kill(signal))
}
process.exit(await child.exited)
