{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@spinosa/tui-agent",
  "version": "0.1.0",
  "description": "Deterministic OpenTUI driver for agent-operated TUI debugging",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TommasoPrinetti/spinosa.git",
    "directory": "packages/tui/tools/tui-agent"
  },
  "homepage": "https://github.com/TommasoPrinetti/spinosa/tree/main/packages/tui/tools/tui-agent#readme",
  "bugs": {
    "url": "https://github.com/TommasoPrinetti/spinosa/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "tui-agent": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./scenario.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "scenario.schema.json"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test scenario.test.ts",
    "prepack": "bun run build"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "keywords": [
    "tui",
    "opentui",
    "testing",
    "agent",
    "terminal"
  ],
  "dependencies": {
    "diff": "8.0.2"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.3.4 <1"
  },
  "devDependencies": {
    "@opentui/core": "0.3.4",
    "@opentui/solid": "0.3.4",
    "@types/bun": "1.3.13",
    "typescript": "5.8.2"
  }
}
