{
  "name": "dialog-variants",
  "description": "Open dialog via /variants, verify model variants dialog renders, then close with escape",
  "adapter": "../adapters/spinosa.ts",
  "terminal": { "width": 100, "height": 50 },
  "fixture": {
    "workspace": { "name": "variants-dialog-test", "setupStatus": "workspace_started" },
    "sessions": [
      { "id": "ses_v", "title": "Variant dialog session", "directory": "$WORKSPACE", "updated": 100 }
    ],
    "responses": [
      { "path": "/global/config", "body": { "autoupdate": "notify" } },
      { "path": "/file", "body": [] },
      { "path": "/config/providers", "body": { "providers": [{ "id": "test", "name": "TUI Agent Test Provider", "models": { "test-model": { "id": "test-model", "name": "Test Model", "cost": { "input": 0, "output": 0 }, "variants": { "creative": "Creative writing mode", "precise": "Precise mode" } } } }], "default": { "test": "test-model" } } },
      { "path": "/session/ses_v/children", "body": [] },
      { "path": "/session/ses_v/diff", "body": [] },
      { "path": "/session/ses_v/todo", "body": [] },
      { "path": "/session/ses_v/permission", "body": [] },
      { "path": "/session/ses_v/question", "body": [] },
      { "path": "/session/ses_v/message", "body": [] },
      { "path": "/session/ses_v/part", "body": [] }
    ]
  },
  "steps": [
    { "action": "waitForText", "text": "Describe the task", "timeoutMs": 8000 },
    { "action": "capture", "name": "home" },

    { "action": "type", "text": "/variants" },
    { "action": "key", "key": "RETURN" },
    { "action": "waitForText", "text": "Select variant", "timeoutMs": 5000 },
    { "action": "assert", "visible": ["Select variant"] },
    { "action": "capture", "name": "variants-dialog" },

    { "action": "key", "key": "escape" }
  ]
}
