{
  "name": "slash-session-share",
  "description": "Open /share dialog from within a session",
  "adapter": "../adapters/spinosa.ts",
  "terminal": { "width": 100, "height": 50 },
  "fixture": {
    "workspace": { "name": "slash-session-test", "setupStatus": "workspace_started" },
    "sessions": [
      { "id": "ses_slash_main", "title": "Slash session test", "directory": "$WORKSPACE", "updated": 500 }
    ],
    "responses": [
      { "path": "/global/config", "body": { "autoupdate": "notify" } },
      { "path": "/file", "body": [] },
      { "path": "/session/ses_slash_main/children", "body": [] },
      { "path": "/session/ses_slash_main/diff", "body": [] },
      { "path": "/session/ses_slash_main/todo", "body": [] },
      { "path": "/session/ses_slash_main/permission", "body": [] },
      { "path": "/session/ses_slash_main/question", "body": [] },
      { "path": "/session/ses_slash_main/message", "body": [] },
      { "path": "/session/ses_slash_main/part", "body": [] }
    ]
  },
  "steps": [
    { "action": "waitForText", "text": "Describe the task", "timeoutMs": 8000 },
    { "action": "capture", "name": "home" },

    { "action": "type", "text": "/session" },
    { "action": "key", "key": "RETURN" },
    { "action": "waitForText", "text": "Slash session test", "timeoutMs": 5000 },
    { "action": "clickText", "text": "Slash session test" },
    { "action": "waitForText", "text": "Export", "timeoutMs": 5000 },

    { "action": "type", "text": "/share" },
    { "action": "key", "key": "RETURN" },
    { "action": "waitForText", "text": "Share Session", "timeoutMs": 5000 },
    { "action": "assert", "visible": ["Share Session"] },
    { "action": "key", "key": "escape" }
  ]
}
