{
  
  "name": "global-home",
  "description": "Exercise workspace picker, Switch workspace dialog, Import files wizard, and Visualizer entry points.",
  "adapter": "../adapters/spinosa.ts",
  "terminal": { "width": 100, "height": 50 },
  "fixture": {
    "workspace": { "name": "home-flows-workspace", "setupStatus": "workspace_started" },
    "sessions": [
      { "id": "ses_recent_1", "title": "Recent design discussion", "directory": "$WORKSPACE", "updated": 500 }
    ],
    "responses": [
      { "path": "/global/config", "body": { "autoupdate": "notify" } },
      { "path": "/file", "body": [] },
      { "path": "/session/ses_recent_1/children", "body": [] },
      { "path": "/session/ses_recent_1/diff", "body": [] },
      { "path": "/session/ses_recent_1/todo", "body": [] },
      { "path": "/session/ses_recent_1/permission", "body": [] },
      { "path": "/session/ses_recent_1/question", "body": [] },
      { "path": "/session/ses_recent_1/message", "body": [] },
      { "path": "/session/ses_recent_1/part", "body": [] }
    ]
  },
  "steps": [
    { "action": "waitForText", "text": "Describe the task", "timeoutMs": 8000 },
    { "action": "capture", "name": "home" },
    { "action": "assert", "visible": ["Switch workspace", "Import files", "Visualizer"] },

    { "action": "clickText", "text": "Visualizer" },
    { "action": "waitForText", "text": "Conversation graphs", "timeoutMs": 8000 },
    { "action": "capture", "name": "visualizer" },
    { "action": "assert", "visible": ["Conversation graphs", "Session:"] },
    { "action": "clickText", "text": "Back" },
    { "action": "assert", "visible": ["Describe the task"] },

    { "action": "clickText", "text": "Switch workspace" },
    { "action": "waitForText", "text": "Choose a workspace", "timeoutMs": 5000 },
    { "action": "capture", "name": "picker" },
    { "action": "assert", "visible": ["home-flows-workspace", "+ New workspace"] },
    { "action": "clickText", "text": "Back" },
    { "action": "assert", "visible": ["Describe the task"] },

    { "action": "clickText", "text": "Import files" },
    { "action": "waitForText", "text": "Import files into workspace", "timeoutMs": 5000 },
    { "action": "capture", "name": "import-files" },
    { "action": "assert", "visible": ["Source folders", "Folder path 1"] },
    { "action": "clickText", "text": "Back" },
    { "action": "assert", "visible": ["Describe the task"] }
  ]
}
