{
  "name": "dialog-timeline-fork",
  "description": "From within a session, open Timeline dialog then Fork dialog and verify both render",
  "adapter": "../adapters/spinosa.ts",
  "terminal": { "width": 100, "height": 50 },
  "fixture": {
    "workspace": { "name": "timeline-fork-test", "setupStatus": "workspace_started" },
    "sessions": [
      { "id": "ses_tf", "title": "Timeline fork session", "directory": "$WORKSPACE", "updated": 500 }
    ],
    "responses": [
      { "path": "/global/config", "body": { "autoupdate": "notify" } },
      { "path": "/file", "body": [] },
      { "path": "/session/ses_tf/children", "body": [] },
      { "path": "/session/ses_tf/diff", "body": [] },
      { "path": "/session/ses_tf/todo", "body": [] },
      { "path": "/session/ses_tf/permission", "body": [] },
      { "path": "/session/ses_tf/question", "body": [] },
      { "path": "/session/ses_tf/message", "body": [] },
      { "path": "/session/ses_tf/part", "body": [] }
    ]
  },
  "steps": [
    { "action": "waitForText", "text": "Describe the task", "timeoutMs": 8000 },
    { "action": "capture", "name": "home" },

    { "action": "type", "text": "/session" },
    { "action": "key", "key": "RETURN" },
    { "action": "waitForText", "text": "Timeline fork session", "timeoutMs": 5000 },
    { "action": "clickText", "text": "Timeline fork session" },
    { "action": "waitForText", "text": "Export", "timeoutMs": 5000 },

    { "action": "type", "text": "/timeline" },
    { "action": "key", "key": "RETURN" },
    { "action": "waitForText", "text": "Timeline", "timeoutMs": 5000 },
    { "action": "assert", "visible": ["Timeline"] },
    { "action": "capture", "name": "timeline-dialog" },
    { "action": "clickText", "text": "esc" },

    { "action": "type", "text": "/fork" },
    { "action": "key", "key": "RETURN" },
    { "action": "waitForText", "text": "Fork session", "timeoutMs": 5000 },
    { "action": "assert", "visible": ["Fork session"] },
    { "action": "capture", "name": "fork-dialog" },
    { "action": "key", "key": "escape" }
  ]
}
