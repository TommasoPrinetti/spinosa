{
  "name": "states-theme",
  "description": "Open /themes dialog, select a different theme, and verify the theme change is applied",
  "adapter": "../adapters/spinosa.ts",
  "terminal": { "width": 100, "height": 50 },
  "fixture": {
    "workspace": { "name": "theme-switch-test", "setupStatus": "workspace_started" },
    "sessions": [
      { "id": "ses_theme", "title": "Theme test session", "directory": "$WORKSPACE", "updated": 500 }
    ],
    "responses": [
      { "path": "/global/config", "body": { "autoupdate": "notify" } },
      { "path": "/file", "body": [] },
      { "path": "/session/ses_theme/children", "body": [] },
      { "path": "/session/ses_theme/diff", "body": [] },
      { "path": "/session/ses_theme/todo", "body": [] },
      { "path": "/session/ses_theme/permission", "body": [] },
      { "path": "/session/ses_theme/question", "body": [] },
      { "path": "/session/ses_theme/message", "body": [] },
      { "path": "/session/ses_theme/part", "body": [] }
    ]
  },
  "steps": [
    { "action": "waitForText", "text": "Describe the task", "timeoutMs": 8000 },
    { "action": "capture", "name": "before-theme" },

    { "action": "type", "text": "/themes" },
    { "action": "key", "key": "RETURN" },
    { "action": "waitForText", "text": "Themes", "timeoutMs": 5000 },
    { "action": "assert", "visible": ["Themes"] },
    { "action": "capture", "name": "theme-dialog" },

    { "action": "key", "key": "escape" }
  ]
}
