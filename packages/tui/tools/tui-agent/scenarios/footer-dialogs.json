{
  "name": "footer-dialogs",
  "description": "Exercise HomeFooter click actions: Settings, Agents, Sessions, Models, and Delete workspace confirm.",
  "adapter": "../adapters/spinosa.ts",
  "terminal": { "width": 100, "height": 50 },
  "fixture": {
    "workspace": { "name": "footer-test-workspace", "setupStatus": "workspace_started" },
    "sessions": [
      { "id": "ses_footer", "title": "Footer test chat", "directory": "$WORKSPACE", "updated": 100 }
    ],
    "responses": [
      { "path": "/global/config", "body": { "autoupdate": "notify" } },
      { "path": "/file", "body": [] }
    ]
  },
  "steps": [
    { "action": "waitForText", "text": "Describe the task", "timeoutMs": 8000 },
    { "action": "waitForText", "text": "Delete workspace", "timeoutMs": 5000 },
    { "action": "capture", "name": "before-dialogs" },
    { "action": "assert", "visible": ["Settings", "Agents", "Sessions", "Provider", "Models", "Delete workspace"] },

    { "action": "clickText", "text": "Settings" },
    { "action": "waitForText", "text": "Notify before updating", "timeoutMs": 8000 },
    { "action": "capture", "name": "settings-dialog" },
    { "action": "assert", "visible": ["Notify before updating", "Release Channel", "Maintenance"] },
    { "action": "key", "key": "ESCAPE" },
    { "action": "waitForText", "text": "Describe the task", "timeoutMs": 5000 },

    { "action": "clickText", "text": "Agents" },
    { "action": "waitForText", "text": "Select agent", "timeoutMs": 5000 },
    { "action": "assert", "visible": ["Select agent"] },
    { "action": "key", "key": "ESCAPE" },
    { "action": "waitForText", "text": "Describe the task", "timeoutMs": 5000 },

    { "action": "clickText", "text": "Sessions" },
    { "action": "waitForText", "text": "Footer test chat", "timeoutMs": 5000 },
    { "action": "key", "key": "ESCAPE" },
    { "action": "waitForText", "text": "Describe the task", "timeoutMs": 5000 },

    { "action": "clickText", "text": "Models" },
    { "action": "waitForText", "text": "Model", "timeoutMs": 8000 },
    { "action": "capture", "name": "models-dialog" },
    { "action": "key", "key": "ESCAPE" },
    { "action": "waitForText", "text": "Describe the task", "timeoutMs": 5000 },

    { "action": "clickText", "text": "Delete workspace" },
    { "action": "waitForText", "text": "Do you really want to delete the workspace folder", "timeoutMs": 5000 },
    { "action": "capture", "name": "delete-confirm" },
    { "action": "assert", "visible": ["Yes, Delete", "No, Keep It"] },
    { "action": "clickText", "text": "No, Keep It" },
    { "action": "waitForText", "text": "Describe the task", "timeoutMs": 5000 },
    { "action": "assert", "visible": ["footer-test-workspace", "Delete workspace"] }
  ]
}
