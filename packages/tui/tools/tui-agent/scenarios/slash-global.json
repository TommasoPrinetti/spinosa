{
  "name": "slash-global-models",
  "description": "Open /models dialog",
  "adapter": "../adapters/spinosa.ts",
  "terminal": { "width": 100, "height": 50 },
  "fixture": {
    "workspace": { "name": "slash-workspace", "setupStatus": "workspace_started" },
    "sessions": [
      { "id": "ses_slash", "title": "Slash session", "directory": "$WORKSPACE", "updated": 100 }
    ],
    "responses": [
      { "path": "/global/config", "body": { "autoupdate": "notify" } },
      { "path": "/file", "body": [] },
      { "path": "/session/ses_slash/children", "body": [] },
      { "path": "/session/ses_slash/diff", "body": [] },
      { "path": "/session/ses_slash/todo", "body": [] },
      { "path": "/session/ses_slash/permission", "body": [] },
      { "path": "/session/ses_slash/question", "body": [] },
      { "path": "/session/ses_slash/message", "body": [] },
      { "path": "/session/ses_slash/part", "body": [] }
    ]
  },
  "steps": [
    { "action": "waitForText", "text": "Describe the task", "timeoutMs": 8000 },
    { "action": "capture", "name": "home" },

    { "action": "type", "text": "/models" },
    { "action": "key", "key": "RETURN" },
    { "action": "waitForText", "text": "Select model", "timeoutMs": 5000 },
    { "action": "assert", "visible": ["Select model"] },
    { "action": "clickText", "text": "esc" }
  ]
}
