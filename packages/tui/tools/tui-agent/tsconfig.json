{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "noUncheckedIndexedAccess": false,
    "outDir": "dist/types",
    "rootDir": "."
  },
  "include": [
    "adapter.ts",
    "artifacts.ts",
    "driver.ts",
    "index.ts",
    "scenario.ts",
    "types.ts"
  ]
}
