{
  "name": "portable-example",
  "description": "Drive a minimal OpenTUI app through the public adapter contract.",
  "adapter": "./simple-adapter.ts",
  "terminal": { "width": 48, "height": 8 },
  "steps": [
    { "action": "waitForText", "text": "Portable TUI" },
    { "action": "waitForFocus", "id": "portable-input" },
    { "action": "type", "text": "hello" },
    {
      "action": "assert",
      "visible": ["Portable TUI", "hello"],
      "route": "demo",
      "dialog": { "open": false },
      "state": { "ready": true }
    }
  ]
}
