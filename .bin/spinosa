print_path_list() {
  local title="$1"
  shift
  local count="$#" shown=0 path remaining
  [[ "$count" -gt 0 ]] || return 0

  info "${title}: ${count}"
  for path in "$@"; do
    shown=$((shown + 1))
    if [[ "$shown" -gt 8 ]]; then
      remaining=$((count - 8))
      note "... ${remaining} more"
      break
    fi
    note "$path"
  done
}

