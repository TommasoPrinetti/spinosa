#!/usr/bin/env bash
# ── rlwrap re-exec for readline + tab completion ───────────────────────────
if [[ -z "${RLWRAP_EXEC:-}" && -t 0 && -t 1 ]] && command -v rlwrap >/dev/null 2>&1; then
  export RLWRAP_EXEC=1
  exec rlwrap -c "$0" "$@"
fi
set -euo pipefail
ORIGINAL_ARGS=("$@")

# ── spinosa — CLI entry point ────────────────────────────────────────────────
# Usage: spinosa [add|new|startup|upgrade|update|uninstall|version|help]
#
# Commands:
#   add       Add files to an existing Spinosa workspace
#   new       Create a new Spinosa workspace and run setup
#   startup   Re-run the startup prompt on an existing workspace
#   upgrade   Upgrade Spinosa CLI to latest release
#   update    Update framework files in the current workspace
#   uninstall Remove Spinosa from this system
#   version   Show Spinosa version
#   help      Show this help

# ── ANSI colors (zero dependencies) ─────────────────────────────────────────
if [[ "${NO_COLOR:-}" == "1" ]] || [[ ! -t 1 ]]; then
  R="" G="" B="" Y="" C="" M="" PG="" DIM="" BOLD="" RESET=""
else
  R=$'\033[31m' G=$'\033[32m' B=$'\033[32m' Y=$'\033[32m'
  C=$'\033[32m' M=$'\033[32m' PG=$'\033[32m' DIM=$'\033[2m' BOLD=$'\033[1m' RESET=$'\033[0m'
fi

# ── terminal width ─────────────────────────────────────────────────────────
COLS="${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}"

# ── paths ───────────────────────────────────────────────────────────────────
SPINOSA_HOME="${SPINOSA_HOME:-$HOME/.spinosa}"
SPINOSA_REPO="${SPINOSA_REPO:-TommasoPrinetti/spinosa}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TODAY="$(date +%Y-%m-%d)"

# ── global cleanup trap ────────────────────────────────────────────────────
cleanup_on_exit() {
  # Kill spinner if running
  if [[ -n "${SPINNER_PID:-}" ]]; then
    kill "$SPINNER_PID" 2>/dev/null || true
    wait "$SPINNER_PID" 2>/dev/null || true
  fi
  # Reset terminal
  stty sane 2>/dev/null || true
  if [[ -t 2 ]]; then
    printf '\033[?25h' >&2
  fi
  return 0
}

cleanup_on_signal() {
  cleanup_on_exit
  exit 130
}

trap cleanup_on_exit EXIT
trap cleanup_on_signal INT TERM

# Source file classes used by integrated onboarding.
MARKDOWN_EXTENSIONS="txt|rtf|textile|wiki|mediawiki|dokuwiki|pmwiki|outliner|workflowy|dynalist|yaml|yml|toml|css|js|ts|py|rb|sh|log|ini|cfg|conf|tex|bib|org|adoc|rst|tiddlywiki|logseq|roam|obsidian"
NATIVE_EXTENSIONS="md"
BINARY_COPYABLE_EXTENSIONS=""
# Engine: MarkItDown — convert supported local files before OCR/copy fallbacks.
# Plugins stay disabled by default; opt in with SPINOSA_MARKITDOWN_ENABLE_PLUGINS=1
# and add plugin-owned extensions with SPINOSA_MARKITDOWN_EXTRA_EXTENSIONS.
MARKITDOWN_EXTENSIONS="docx|pptx|xlsx|xls|epub|html|htm|msg|zip|json|csv|xml"
STRUCTURED_FALLBACK_EXTENSIONS="csv|json|xml"
IMAGE_EXTENSIONS="jpg|jpeg|png|gif|webp|heic|heif|tif|tiff|bmp|svg"
AUDIO_VIDEO_EXTENSIONS="mp4|mov|m4v|avi|mkv|webm|wmv|mp3|wav|m4a|aac|flac|ogg|opus|aiff"
OPTION_SEP=$'\t'

# Resolve framework root:
#   - Dev mode: binary is in .bin/ of the repo → FRAMEWORK_ROOT is repo root
#   - Installed mode: binary is in ~/.spinosa/bin/ → framework is in ~/.spinosa/versions/<latest>/
resolve_framework_root() {
  # Dev mode: check if we're in the repo's .bin/
  local candidate="${SCRIPT_DIR}/.."
  if [[ -f "${candidate}/.spinosa/framework-files.tsv" ]]; then
    echo "$candidate"
    return
  fi

  # Installed mode: find latest version
  if [[ -d "${SPINOSA_HOME}/versions" ]]; then
      local latest_version
      if sort -V /dev/null 2>/dev/null; then
        latest_version="$(ls -1 "${SPINOSA_HOME}/versions" 2>/dev/null | sort -V | tail -1)"
      else
        latest_version="$(ls -1 "${SPINOSA_HOME}/versions" 2>/dev/null | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)"
      fi
    if [[ -n "$latest_version" ]]; then
      local fw_dir="${SPINOSA_HOME}/versions/${latest_version}"
      # The archive unpacks to spinosa-framework-<version>/
      local fw_subdir
      fw_subdir="$(find "$fw_dir" -maxdepth 1 -type d -name 'spinosa-framework-*' 2>/dev/null | head -1)"
      if [[ -n "$fw_subdir" && -f "${fw_subdir}/.spinosa/framework-files.tsv" ]]; then
        echo "$fw_subdir"
        return
      fi
    fi
  fi

  echo ""
}

FRAMEWORK_ROOT="$(resolve_framework_root)"
SPINOSA_BANNER_PRINTED=0

# ── sourced libraries ───────────────────────────────────────────────────────
SPINOSA_LIB_DIR="${FRAMEWORK_ROOT}/.bin/lib/spinosa"
SPINOSA_LIBS=(
  ui
  core
  handoff
  import
  import_scan
  import_copy
  import_onboarding_log
  workspace
  tools
  commands_new
  commands_add
  commands_system
  commands_dashboard
  commands_startup
)
for spinosa_lib in "${SPINOSA_LIBS[@]}"; do
  spinosa_lib_path="${SPINOSA_LIB_DIR}/${spinosa_lib}.sh"
  if [[ ! -f "$spinosa_lib_path" ]]; then
    printf 'Missing Spinosa library: %s\n' "$spinosa_lib_path" >&2
    exit 1
  fi
  # shellcheck source=/dev/null
  source "$spinosa_lib_path"
done

# ── Pre-parse global flags ──────────────────────────────────
while true; do
  case "${1:-}" in
    --no-upgrade-check) export SPINOSA_NO_UPGRADE_CHECK=1; shift ;;
    --no-color)  R="" G="" B="" Y="" C="" M="" PG="" DIM="" BOLD="" RESET=""; shift ;;
    --numbered)  NUMBERED="1"; shift ;;
    *) break ;;
  esac
done

# ── Call auto-upgrade check before command screens render ──
if [[ "${1:-}" != "upgrade" ]] && [[ "${1:-}" != "uninstall" ]] && [[ "${1:-}" != "doctor" ]] && [[ "${1:-}" != "version" ]] && [[ "${1:-}" != "--version" ]] && [[ "${1:-}" != "-v" ]]; then
  auto_upgrade_check
fi

# ═══════════════════════════════════════════════════════════════════════════
# MAIN
# ═══════════════════════════════════════════════════════════════════════════
case "${1:-}" in
  add)       shift; cmd_add "$@" ;;
  new)       shift; cmd_new "$@" ;;
  startup)   shift; cmd_startup "$@" ;;
  upgrade)   shift; cmd_upgrade "$@" ;;
  update)    shift; cmd_update "$@" ;;
  doctor)    shift; cmd_doctor "$@" ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  version|--version|-v) printf 'spinosa %s\n' "$(framework_version "$FRAMEWORK_ROOT")"; exit 0 ;;
  help|-h|--help) cmd_help ;;
  "") cmd_dashboard ;;
  *)
    printf '%s\n' "${R}Unknown command: $1${RESET}" >&2
    cmd_help
    exit 1
    ;;
esac
