#!/usr/bin/env bash
# Spinosa bootstrap launcher.
# Resolves the framework root and Bun runtime, then starts the kernel CLI.
# Command logic lives in packages/spinosa-kernel/src/index.ts.
# TUI launch preflight runs inside the kernel (cmd/tui.ts), not in this script.
set -euo pipefail

_verbose=false
for _arg in "$@"; do
  case "$_arg" in --verbose) _verbose=true; break ;; esac
done
_btlog() { $_verbose && echo "[boot:bash:$1] $2" >&2 || true; }

_btlog init "spinosa launcher started"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_btlog init "SCRIPT_DIR=$SCRIPT_DIR"
RESOLVED_ROOT=""
if [[ -z "${SPINOSA_HOME:-}" && -d "${SCRIPT_DIR}/../versions" && -d "${SCRIPT_DIR}/../metadata" ]]; then
  SPINOSA_HOME="$(cd "${SCRIPT_DIR}/.." && pwd)"
else
  SPINOSA_HOME="${SPINOSA_HOME:-$HOME/.spinosa}"
fi
export SPINOSA_HOME
_btlog init "SPINOSA_HOME=$SPINOSA_HOME"

# Resolve system root (3 tiers)
candidate="${SCRIPT_DIR}/.."
if [[ -f "${candidate}/.spinosa/workspace-files.tsv" ]]; then
  RESOLVED_ROOT="$(cd "$candidate/.." && pwd)"
  _btlog root "tier1: resolved from workspace-files.tsv in parent"
else
  candidate2="${SCRIPT_DIR}/../.."
  if [[ -f "${candidate2}/workspace-template/.spinosa/workspace-files.tsv" ]]; then
    RESOLVED_ROOT="$candidate2"
    _btlog root "tier2: resolved from workspace-template in grandparent"
  fi
fi
if [[ -z "$RESOLVED_ROOT" && -d "${SPINOSA_HOME}/versions" ]]; then
  _btlog root "tier3: scanning versions dir"
  while IFS= read -r candidate3; do
    v="$(basename "$candidate3")"
    [[ "$v" =~ ^[0-9] ]] || continue
    if [[ -f "${candidate3}/workspace-template/.spinosa/workspace-files.tsv" ]]; then
      RESOLVED_ROOT="$candidate3"
      _btlog root "tier3: resolved from version $v"
      break
    fi
  done < <(find "${SPINOSA_HOME}/versions" -mindepth 1 -maxdepth 1 -type d -print 2>/dev/null | sort -V -r)
fi

# Find bun — bundled install first, then system
BUN=""
[[ -x "${SPINOSA_HOME:-$HOME/.spinosa}/bin/bun" ]] && BUN="${SPINOSA_HOME:-$HOME/.spinosa}/bin/bun" && _btlog bun "bundled bun at $BUN"
if [[ -z "$BUN" ]] && command -v bun >/dev/null 2>&1; then
  BUN="$(command -v bun)"
  _btlog bun "system bun at $BUN"
fi

# Installed releases validate their runtime before dispatch. If node_modules or
# Bun are damaged, rebuild that release while preserving ~/.spinosa/metadata,
# then re-run the exact original command once.
installed_release=false
case "$RESOLVED_ROOT" in
  "${SPINOSA_HOME}/versions/"*) installed_release=true ; _btlog root "installed release: $RESOLVED_ROOT" ;;
esac

runtime_healthy() {
  [[ -n "$RESOLVED_ROOT" && -n "$BUN" ]] || return 1
  SPINOSA_TEMPLATE_ROOT="$RESOLVED_ROOT" \
    "$BUN" run "${RESOLVED_ROOT}/packages/spinosa-kernel/src/index.ts" version >/dev/null 2>&1
}

ensure_runtime() {
  [[ -z "$RESOLVED_ROOT" || -z "$BUN" ]] && return 1
  link_workspace_packages "$RESOLVED_ROOT"
  runtime_healthy && return 0
  # try refreshing deps
  _btlog ensure "running bun install to resolve dependencies"
  "$BUN" install --cwd "$RESOLVED_ROOT" --no-summary >/dev/null 2>&1 || true
  link_workspace_packages "$RESOLVED_ROOT"
  runtime_healthy
}

# Ensure workspace package symlinks exist for installed releases.
# Without these, bun cannot resolve @spinosa/* workspace imports.
link_workspace_packages() {
  local root="$1" nm="${1}/node_modules/@spinosa"
  [[ -d "$nm" && -L "${nm}/core" && -L "${nm}/kernel" ]] && return 0
  mkdir -p "$nm" 2>/dev/null || true
  for _pkg in "$root"/packages/*/; do
    _name="$(basename "$_pkg")"
    _pkgjson="$_pkg/package.json"
    [[ -f "$_pkgjson" ]] || continue
    _scoped="$(grep '"name"' "$_pkgjson" | head -1 | sed 's/.*"name": *"\([^"]*\)".*/\1/')"
    [[ "$_scoped" == @spinosa/* ]] || continue
    _short="${_scoped#@spinosa/}"
    [[ -L "${nm}/${_short}" ]] || ln -sfn "../../packages/$_name" "${nm}/${_short}" 2>/dev/null || true
  done
}

_btlog health "RESOLVED_ROOT=$RESOLVED_ROOT, BUN=$BUN"
if [[ "$installed_release" == "true" ]] && ! ensure_runtime; then
  _btlog health "runtime unhealthy, attempting repair"
  _ver="$(tr -d '[:space:]' < "${RESOLVED_ROOT}/metadata/version" 2>/dev/null || basename "$RESOLVED_ROOT")"
  printf 'Spinosa runtime issue detected. v%s\n' "$_ver" >&2
  printf 'Reinstall to fix? [Y/n] ' >&2
  read -r _repair_ans
  case "${_repair_ans:-y}" in
    y|Y|yes|YES|"") ;;
    *) printf 'Aborting.\n' >&2; exit 1 ;;
  esac
  rm -f "${SPINOSA_HOME}/versions/.install.lock" 2>/dev/null || true
  if bash "${RESOLVED_ROOT}/install.sh" --version "$_ver" --yes --reinstall --no-launch --no-modify-path; then
    _btlog health "reinstall complete, re-running original command"
    exec "$0" "$@"
  fi
  echo "Error: Spinosa reinstall failed. Metadata was preserved." >&2
  echo "Re-run the installer with --yes --reinstall for details." >&2
  exit 1
fi
_btlog health "runtime healthy"

# Route to the TUI only for no-args, explicit tui, or new/create without a source.
# Every other command is dispatched to the kernel CLI (single command router).
launcher_args=("$@")
command_index=0
while [[ "${launcher_args[$command_index]:-}" == "--json" || "${launcher_args[$command_index]:-}" == "--quiet" || "${launcher_args[$command_index]:-}" == "--no-color" ]]; do
  command_index=$((command_index + 1))
done
launcher_command="${launcher_args[$command_index]:-}"
remaining_args=$(( ${#launcher_args[@]} - command_index - 1 ))
tui_launch=false
if [[ -z "$launcher_command" ]]; then
  tui_launch=true
elif [[ "$launcher_command" == "tui" ]]; then
  tui_launch=true
elif [[ "$launcher_command" == "new" || "$launcher_command" == "create" ]] && [[ "$remaining_args" -eq 0 ]]; then
  tui_launch=true
fi

if [[ "$tui_launch" == "true" && -d "${RESOLVED_ROOT}/packages/tui/src" && -n "$BUN" ]]; then
  export SPINOSA_TEMPLATE_ROOT="$RESOLVED_ROOT"
  # Kernel TUI runs launch preflight. Exit 10 means re-exec after upgrade.
  set +e
  SPINOSA_TEMPLATE_ROOT="$RESOLVED_ROOT" \
    "$BUN" run "${RESOLVED_ROOT}/packages/spinosa-kernel/src/index.ts" "$@"
  exit_code=$?
  set -e
  if [[ "$exit_code" -eq 10 ]]; then
    _btlog tui "kernel requested restart after upgrade"
    export SPINOSA_UPGRADE_REEXEC=1
    exec "$0" "$@"
  fi
  exit "$exit_code"
fi

if [[ -n "$RESOLVED_ROOT" && -n "$BUN" ]]; then
  _btlog dispatch "dispatching to kernel for command: ${launcher_command:-<default>}"
  export SPINOSA_TEMPLATE_ROOT="$RESOLVED_ROOT"
  exec "$BUN" run "${RESOLVED_ROOT}/packages/spinosa-kernel/src/index.ts" "$@"
fi

_btlog tui "failed: RESOLVED_ROOT or BUN not found (${RESOLVED_ROOT:-unset}, ${BUN:-unset})"
echo "Error: Spinosa not found. Run the installer or re-install dependencies." >&2
exit 1
