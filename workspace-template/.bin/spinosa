#!/usr/bin/env bash
# ── spinosa — TUI launcher (thin) ──────────────────────────────────────────
# For CLI usage, run the TUI directly. All commands handled in TypeScript.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Resolve system root (where packages/ lives)
RESOLVED_ROOT=""
candidate="${SCRIPT_DIR}/.."
if [[ -f "${candidate}/.spinosa/workspace-files.tsv" ]]; then
  RESOLVED_ROOT="$candidate"
else
  # Installed mode: binary is in template's .bin/, system root is two levels up
  candidate2="${SCRIPT_DIR}/../.."
  if [[ -f "${candidate2}/workspace-template/.spinosa/workspace-files.tsv" ]]; then
    RESOLVED_ROOT="$candidate2"
  fi
fi

if [[ -z "$RESOLVED_ROOT" ]]; then
  echo "Error: Spinosa template not found." >&2
  exit 1
fi

# Dev mode: launch local TUI from packages/opencode
if [[ -d "${RESOLVED_ROOT}/packages/opencode" ]]; then
  BUN="${BUN:-$(command -v bun || true)}"
  if [[ -n "$BUN" ]]; then
    export SPINOSA_TEMPLATE_ROOT="$RESOLVED_ROOT"
    exec "$BUN" run --cwd "${RESOLVED_ROOT}/packages/opencode" --conditions=browser src/index.ts "$@"
  fi
fi

# Installed mode: launch from @spinosa/tui or system opencode
if command -v npx >/dev/null 2>&1 && npx --yes @spinosa/tui --version >/dev/null 2>&1; then
  exec npx @spinosa/tui "$@"
fi
if command -v opencode >/dev/null 2>&1; then
  exec opencode "$@"
fi

echo "Error: Spinosa TUI not available. Re-run installer." >&2
exit 1
