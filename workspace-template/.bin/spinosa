#!/usr/bin/env bash
# ── spinosa — Bootstrap launcher ────────────────────────────────────────────
# Resolves Spinosa root and Bun runtime, then dispatches to TypeScript CLI
# or TUI. All command logic lives in packages/tui/src/spinosa-cli.ts.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RESOLVED_ROOT=""
SPINOSA_HOME="${SPINOSA_HOME:-$HOME/.spinosa}"

# Resolve system root (3 tiers)
candidate="${SCRIPT_DIR}/.."
if [[ -f "${candidate}/.spinosa/workspace-files.tsv" ]]; then
  RESOLVED_ROOT="$(cd "$candidate/.." && pwd)"
else
  candidate2="${SCRIPT_DIR}/../.."
  if [[ -f "${candidate2}/workspace-template/.spinosa/workspace-files.tsv" ]]; then
    RESOLVED_ROOT="$candidate2"
  fi
fi
if [[ -z "$RESOLVED_ROOT" && -d "${SPINOSA_HOME}/versions" ]]; then
  while IFS= read -r candidate3; do
    v="$(basename "$candidate3")"
    [[ "$v" =~ ^[0-9] ]] || continue
    if [[ -f "${candidate3}/workspace-template/.spinosa/workspace-files.tsv" ]]; then
      RESOLVED_ROOT="$candidate3"
      break
    fi
  done < <(find "${SPINOSA_HOME}/versions" -mindepth 1 -maxdepth 1 -type d -print 2>/dev/null | sort -V -r)
fi

# Find bun — bundled install first, then system
BUN=""
[[ -x "${SPINOSA_HOME:-$HOME/.spinosa}/bin/bun" ]] && BUN="${SPINOSA_HOME:-$HOME/.spinosa}/bin/bun"
if [[ -z "$BUN" ]] && command -v bun >/dev/null 2>&1; then
  BUN="$(command -v bun)"
fi

# Dispatch to TS CLI for all non-interactive commands.
# new/create without a source argument still launches the TUI dashboard.
dispatch=false
case "${1:-}" in
  help|--help|-h|version|--version|add|update|doctor|upgrade|uninstall|status|list) dispatch=true ;;
  new|create) [[ $# -gt 1 ]] && dispatch=true ;;
esac
if [[ "$dispatch" == "true" ]]; then
  [[ -z "$RESOLVED_ROOT" || -z "$BUN" ]] && { echo "Error: Spinosa runtime not found. Reinstall Spinosa." >&2; exit 1; }
  export SPINOSA_TEMPLATE_ROOT="$RESOLVED_ROOT"
  exec "$BUN" run "${RESOLVED_ROOT}/packages/tui/src/spinosa-cli.ts" "$@"
fi

# Unknown command — reject instead of silently falling through to TUI
if [[ $# -gt 0 && "${1:-}" != "new" && "${1:-}" != "create" ]]; then
  echo "Error: Unknown Spinosa command: ${1}" >&2
  echo "Run 'spinosa help' for usage." >&2
  exit 1
fi

# No-args or new/create without source → launch TUI
if [[ -d "${RESOLVED_ROOT}/packages/opencode" && -n "$BUN" ]]; then
  export SPINOSA_TEMPLATE_ROOT="$RESOLVED_ROOT"
  exec "$BUN" run --cwd "${RESOLVED_ROOT}/packages/opencode" --conditions=browser src/index.ts "$@"
fi

echo "Error: Spinosa not found. Run the installer or re-install dependencies." >&2
exit 1
